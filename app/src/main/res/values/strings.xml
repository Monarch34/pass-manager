    <string name="device_binding_status_off">Off. A copy of your vault file could be attacked on another machine.</string>
    <string name="device_binding_dialog_title">Bind this vault to this phone?</string>
    <string name="device_binding_dialog_body">Your vault key gets a second lock that only this phone can open, so a stolen copy of the vault file is useless anywhere else. Your passphrase keeps working exactly as before.</string>
    <string name="device_binding_dialog_warning">If you lose this phone, factory reset it, or clear the app\'s data, the vault on it can never be opened again — not even with the right passphrase. An encrypted backup file is the only way back.</string>
