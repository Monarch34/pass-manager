        <path android:strokeColor="@color/logo_circuit_right" android:strokeWidth="4" android:strokeLineCap="round" android:strokeLineJoin="round" android:pathData="M 245 310 L 260 310 L 260 340 L 280 340" />
        <path android:fillColor="@color/logo_circuit_right" android:pathData="M 277 340 a 3 3 0 1 0 6 0 a 3 3 0 1 0 -6 0" />

        <path android:strokeColor="@color/logo_circuit_right" android:strokeWidth="4" android:strokeLineCap="round" android:strokeLineJoin="round" android:pathData="M 230 335 L 230 370 L 255 370" />
