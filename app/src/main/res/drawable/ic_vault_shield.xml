        <path android:fillColor="@color/logo_circuit_right" android:pathData="M 252 210 a 3 3 0 1 0 6 0 a 3 3 0 1 0 -6 0" />
        <path android:fillColor="@color/logo_circuit_right" android:pathData="M 272 270 a 3 3 0 1 0 6 0 a 3 3 0 1 0 -6 0" />
        <path android:fillColor="@color/logo_circuit_right" android:pathData="M 262 300 a 3 3 0 1 0 6 0 a 3 3 0 1 0 -6 0" />
    </group>

    <!-- Center Lock Left -->
    <path android:fillColor="@color/logo_teal_dark" android:pathData="M 200 250 A 40 40 0 0 0 200 330 L 200 315 A 25 25 0 0 1 200 265 Z" />
    <path android:fillColor="@color/logo_teal_dark" android:pathData="M 200 277 A 8 8 0 0 0 193.5 289.5 L 190 305 L 200 305 Z" />

    <!-- Center Lock Right -->
    <path android:fillColor="@color/logo_teal_light" android:pathData="M 200 250 A 40 40 0 0 1 200 330 L 200 315 A 25 25 0 0 0 200 265 Z" />
    <path android:fillColor="@color/logo_teal_light" android:pathData="M 200 277 A 8 8 0 0 1 206.5 289.5 L 210 305 L 200 305 Z" />

    </group>
</vector>
