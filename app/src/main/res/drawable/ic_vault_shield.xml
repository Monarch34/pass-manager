<?xml version="1.0" encoding="utf-8"?>
<!--
  The single canonical colour drawing of the vault shield. The adaptive-icon foreground
  (ic_launcher_foreground.xml) and the in-app AppShieldLogo both reference this file rather than
  carrying their own copy: the two used to be byte-identical apart from ten stroke colours, and that
  lone difference is exactly how they drifted apart.

  The viewport is the shield's own bounding box — 280x335, i.e. x 60..340 and y 135..470 once the
  group translate is applied — so every caller frames the mark by transform alone and none of them
  has to re-express the geometry in its own units.

  The declared 42 x 50.25dp is the size this art occupies inside the 108dp adaptive-icon canvas, not
  a size anything renders at. <inset> has no dimensions of its own and takes its intrinsic size from
  the child, so declaring the raw 280x335 viewport here made @mipmap/ic_launcher report an intrinsic
  ~720dp square. Nothing on screen changed — AdaptiveIconDrawable scales every layer to its bounds —
  but anything that measures the app icon read the wrong number. In-app the vector is drawn through
  fillMaxSize + ContentScale.Fit, which is indifferent to the declared dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="42dp"
    android:height="50.25dp"
    android:viewportWidth="280"
    android:viewportHeight="335">

    <group android:translateX="-60.0" android:translateY="-135.0">

    <!-- Top Cap Left -->
    <path android:fillColor="@color/logo_teal_dark" android:pathData="M 200 135 L 169 140 L 200 170 Z" />
    <!-- Top Cap Right -->
    <path android:fillColor="@color/logo_teal_light" android:pathData="M 200 135 L 231 140 L 200 170 Z" />

    <!-- Outer Shield Left -->
    <path android:fillColor="@color/logo_teal_dark" android:pathData="M 200 200 L 169 170 L 60 190 C 60 340 110 430 200 470 Z" />
    <!-- Outer Shield Right -->
    <path android:fillColor="@color/logo_teal_light" android:pathData="M 200 200 L 231 170 L 340 190 C 340 340 290 430 200 470 Z" />

    <!-- Inner Shield Left -->
    <path android:fillColor="@color/logo_inner_left" android:pathData="M 200 200 L 85 215 C 85 330 125 410 200 440 Z" />
    <!-- Inner Shield Right -->
    <path android:fillColor="@color/logo_inner_right" android:pathData="M 200 200 L 315 215 C 315 330 275 410 200 440 Z" />

    <!-- Top V Detail Left -->
    <path android:fillColor="@color/logo_teal_dark" android:pathData="M 100 150 L 150 150 L 200 200 L 200 250 Z" />
    <!-- Top V Detail Right -->
    <path android:fillColor="@color/logo_teal_light" android:pathData="M 300 150 L 250 150 L 200 200 L 200 250 Z" />

    <!-- Circuit Traces Left -->
    <group>
        <path android:strokeColor="@color/logo_circuit_left" android:strokeWidth="4" android:strokeLineCap="round" android:strokeLineJoin="round" android:pathData="M 155 260 L 130 260 L 130 230" />
        <path android:fillColor="@color/logo_circuit_left" android:pathData="M 127 230 a 3 3 0 1 0 6 0 a 3 3 0 1 0 -6 0" />

        <path android:strokeColor="@color/logo_circuit_left" android:strokeWidth="4" android:strokeLineCap="round" android:strokeLineJoin="round" android:pathData="M 155 285 L 115 285 L 115 310" />
        <path android:fillColor="@color/logo_circuit_left" android:pathData="M 112 310 a 3 3 0 1 0 6 0 a 3 3 0 1 0 -6 0" />

        <path android:strokeColor="@color/logo_circuit_left" android:strokeWidth="4" android:strokeLineCap="round" android:strokeLineJoin="round" android:pathData="M 155 310 L 140 310 L 140 340 L 120 340" />
        <path android:fillColor="@color/logo_circuit_left" android:pathData="M 117 340 a 3 3 0 1 0 6 0 a 3 3 0 1 0 -6 0" />

        <path android:strokeColor="@color/logo_circuit_left" android:strokeWidth="4" android:strokeLineCap="round" android:strokeLineJoin="round" android:pathData="M 170 335 L 170 370 L 145 370" />
        <path android:fillColor="@color/logo_circuit_left" android:pathData="M 142 370 a 3 3 0 1 0 6 0 a 3 3 0 1 0 -6 0" />

        <path android:strokeColor="@color/logo_circuit_left" android:strokeWidth="4" android:strokeLineCap="round" android:strokeLineJoin="round" android:pathData="M 180 345 L 180 390 L 160 390" />
