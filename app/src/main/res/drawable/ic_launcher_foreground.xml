<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground. It carries no path data of its own: this file and ic_vault_shield.xml
  were byte-identical apart from ten stroke colours and still managed to drift, so there is now one
  drawing and one wrapper that places it.

  The fractions put the 280x335 art at x 33.0..75.0 and y 28.875..79.125 of the 108 canvas, centred
  on (54,54) with a 65.49-unit diagonal — inside the 66-unit safe circle that survives every launcher
  mask. The inner box is 42.0 x 50.25, whose aspect is exactly 280:335, so the vector is placed
  rather than stretched.

  Percentages and not dp insets: the launcher scales adaptive-icon layers to whatever pixel size it
  needs, and a dp inset resolves once against the density, so it would stop tracking the layer.
  InsetDrawable's inset attributes are typed dimension|fraction (API 26+, which is this app's
  minSdk and the floor for adaptive icons anyway), so a percentage here is measured against the
  layer's own bounds — there is no separate insetLeftFraction attribute.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_vault_shield"
    android:insetLeft="30.5556%"
    android:insetRight="30.5556%"
    android:insetTop="26.7361%"
    android:insetBottom="26.7361%" />
