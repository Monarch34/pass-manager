<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!-- Without this layer an Android 13+ themed home screen has nothing to tint and falls back to
         the full-colour icon, leaving this app the one bright tile among monochrome neighbours. It
         registers with the foreground because both resolve to the same transform on the 108 canvas. -->
    <monochrome android:drawable="@drawable/ic_vault_shield_mono" />
</adaptive-icon>
